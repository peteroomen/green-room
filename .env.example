# Add these in Vercel Settings > Environment Variables. No VITE_ prefix.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required for hosted AI endpoints. Unlock in the app's Settings.
APP_PASSWORD=
# Optional provider adapters. Set both key and model to enable.
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=
